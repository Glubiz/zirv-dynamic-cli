{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check-doc-coverage.sh\"",
            "timeout": 10,
            "statusMessage": "Checking documentation coverage..."
          }
        ]
      }
    ]
  }
}
