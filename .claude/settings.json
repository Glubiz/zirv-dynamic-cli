{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check-doc-coverage.sh",
            "timeout": 10,
            "statusMessage": "Checking documentation coverage..."
          }
        ]
      }
    ]
  }
}
