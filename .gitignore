/target

# Raw PTY capture of a real local session (may contain personal session content;
# recorded via `cargo run --example vt_spike -- --record ...`, used by vt100 tests
# when present, tests skip when absent)
tests/fixtures/claude-session.raw

# Root-level Obsidian workspace state (user-local; the tracked vault config lives at docs/obsidian/.obsidian)
/.obsidian/
# User-local Obsidian pane state inside the vault
docs/obsidian/.obsidian/workspace*.json

# Session scratch from agent harnesses
.superpowers/

# `zirv ctx agent --worktree`'s own linked worktrees (issue #306 follow-up):
# removed by the reclamation step in agent.rs when clean, left in place
# (still ignored) when dirty for the operator to inspect.
.zirv/worktrees/
.zirv/memory/.lock
